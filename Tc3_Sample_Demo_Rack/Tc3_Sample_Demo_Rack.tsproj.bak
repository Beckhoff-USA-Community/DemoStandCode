									<ContextId OnlineAccess="true">0</ContextId>
								</Parameter>
								<Parameter Group="Scaling">
									<Name>Encoder Mounting Offset</Name>
									<Comment><![CDATA[Offset that absolute encoders use to align their position in the machine coordinate system and is thus used to define the machine-related zero point.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
