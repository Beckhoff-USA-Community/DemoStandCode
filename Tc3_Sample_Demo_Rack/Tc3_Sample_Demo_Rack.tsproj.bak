								<Parameter Group="Scaling">
									<Name>Position Scaling Numerator From Hardware</Name>
									<Comment><![CDATA[Used to convert encoder increments to axis position. For example, the numerator can be the feed constant when the output shaft has done one revolution.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Unit><![CDATA[[PosUnit]/INC]]></Unit>
									<Default>
