		<ModuleTmc GUID="{48F33D24-2A1B-4C09-8503-9500E9D277B5}">
			<Name>Simulation Drive</Name>
			<CLSID ClassFactory="Tc3_Mc3Ptp_Core">{050300B5-0000-0000-F000-000000000064}</CLSID>
			<Info>
				<ImageData></ImageData>
			</Info>
			<Parameters>
				<Parameter Group="Scaling">
					<Name>Encoder Mounting Offset</Name>
					<Comment><![CDATA[Defines the permanent correction value for the physical encoder alignment. Set once during commissioning.]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
					<Unit><![CDATA[[PosUnit]]]></Unit>
					<Default>
						<Value>0.0</Value>
					</Default>
					<PTCID>#x05030106</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
				<Parameter OnlineParameter="true" Group="Scaling">
					<Name>Work Zero Offset</Name>
					<Comment><![CDATA[User-defined shift relative to the machine zero point. Used to define the product start or specific work coordinates.]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
					<Unit><![CDATA[[PosUnit]]]></Unit>
					<Default>
						<Value>0.0</Value>
					</Default>
					<PTCID>#x050301d1</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
				<Parameter OnlineParameter="true" ReadOnly="true" Group="Scaling">
					<Name>Active Homing Offset</Name>
					<Comment><![CDATA[Displays the temporary offset calculated during the last homing sequence. This value is not stored persistently.]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
					<Unit><![CDATA[[PosUnit]]]></Unit>
					<Default>
						<Value>0.0</Value>
					</Default>
					<PTCID>#x05030224</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
				<Parameter OnlineParameter="true" HideParameter="true" ReadOnly="true" Group="Is Position Valid">
					<Name>Is Homed</Name>
					<Comment><![CDATA[Displays whether the drive is homed. This value is not stored persistently.]]></Comment>
					<BitSize>8</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-000000000030}">BOOL</BaseType>
					<Default>
						<Value>0</Value>
					</Default>
					<PTCID>#x0503d070</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
				<Parameter OnlineParameter="true" HideParameter="true" ReadOnly="true" Group="Is Position Valid">
					<Name>Is Absolute Position Valid</Name>
					<Comment><![CDATA[Displays whether the absolute position is valid. This value is not stored persistently.]]></Comment>
					<BitSize>8</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-000000000030}">BOOL</BaseType>
					<Default>
						<Value>0</Value>
					</Default>
					<PTCID>#x0503d071</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
