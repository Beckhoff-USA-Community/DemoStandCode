							<SubVar>
								<Name>ItpMode</Name>
								<Comment><![CDATA[0x0000 = Default (deactivates the other modes)
0x0001 = Single Block Mode NC Kernel (SAF)
0x4000 = Single Block Mode Interpreter
]]></Comment>
							</SubVar>
							<SubVar>
								<Name>ItpState</Name>
								<Comment><![CDATA[Interpreter Operation State:
0  = Init failed
1  = Idle
2  = Ready
3  = Started
4  = Scanning
5  = Running
6  = Stay running
7  = Write table
8  = Search line
9  = End
10 = Single Step
11 = Aborting
12 = Aborted
13 = Fault
14 = Reset
15 = Stop
16 = Wait function
17 = Flush buffers
]]></Comment>
							</SubVar>
						</Var>
