									</Default>
									<PTCID>#x05030103</PTCID>
									<ContextId OnlineAccess="true">0</ContextId>
								</Parameter>
								<Parameter Group="Scaling">
									<Name>Position Scaling Denominator From Hardware</Name>
									<Comment><![CDATA[Used to convert encoder increments to axis position. For example, the denominator can be the number of increments that the drive outputs when the motor shaft has done one revolution.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Default>
										<Value>1048576</Value>
