								<Parameter Group="Dead Time Compensation">
									<Name>Dead Time Compensation</Name>
									<Comment><![CDATA[Set how the compensated setpoint and actpoint are to be calculated. The dead time is determined automatically during EtherCAT initialization.]]></Comment>
									<BitSize>32</BitSize>
									<BaseType GUID="{EC228BB1-A74E-4EA9-958E-255C8F4CB262}" Namespace="MC">EDeadTimeCompensationMode</BaseType>
