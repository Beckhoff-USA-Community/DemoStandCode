			<Name GUID="{15F9F152-5D43-412E-AD2A-4BB310063E1F}" Namespace="MC" TcBaseType="true">EPositionLagSource</Name>
			<BitSize>32</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[HardwareProvidedIfAvailable]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Uses hardware-provided position lag if available, otherwise falls back to internal calculation.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[InternallyCalculated]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[Position lag is always calculated internally from position of setpoint and actual position.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[HardwareProvided]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[Position lag is always taken from hardware. Requires hardware support and mapping.]]></Comment>
			</EnumInfo>
