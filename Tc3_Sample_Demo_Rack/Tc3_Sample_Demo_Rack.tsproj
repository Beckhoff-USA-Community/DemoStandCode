							<Parameters>
								<Group><![CDATA[General]]></Group>
								<Group Collapsed="true"><![CDATA[Control Parameter]]></Group>
								<Group Collapsed="true"><![CDATA[Output Limitation]]></Group>
								<Parameter Group="General">
									<Name>Control Value Type</Name>
									<Comment><![CDATA[Defines the type of the controller output variable. For example, 'Velocity' means that the controller output is a velocity.]]></Comment>
									<BitSize>32</BitSize>
									<BaseType GUID="{2A8F8431-AD7B-4D3D-A2F8-F05E47C7B199}" Namespace="MC">EControlValueType</BaseType>
									<Default>
										<EnumText>Velocity</EnumText>
									</Default>
									<PTCID>#x05030128</PTCID>
								</Parameter>
								<Parameter Group="General">
									<Name>Enabled</Name>
									<Comment><![CDATA[Whether the position controller is used or not. Controller output is 0.0 if disabled.]]></Comment>
									<BitSize>8</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-000000000030}">BOOL</BaseType>
									<Default>
										<Value>1</Value>
									</Default>
									<PTCID>#x05030147</PTCID>
								</Parameter>
								<Parameter Group="General">
									<Name>Feed Forward Factor</Name>
									<Comment><![CDATA[The product of Feed Forward Factor and the velocity setpoint is added to the sum of P, I and D, resulting in the "Control Value Final Output".]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Default>
										<Value>1.0</Value>
									</Default>
									<PTCID>#x05030148</PTCID>
								</Parameter>
								<Parameter Group="Control Parameter">
									<Name>Proportional Gain (Kp)</Name>
									<Comment><![CDATA[The proportional gain is multiplied with the current error, resulting in one term of the control value.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Unit><![CDATA[[ControlValueUnit]/[PosUnit]]]></Unit>
									<Default>
										<Value>1.0</Value>
									</Default>
									<PTCID>#x0503012a</PTCID>
								</Parameter>
								<Parameter Group="Control Parameter">
									<Name>Derivative Gain (Kd)</Name>
									<Comment><![CDATA[The derivative gain is multiplied with the derivative of the error, resulting in one term of the control value.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Unit><![CDATA[[ControlValueUnit]/([PosUnit]/s)]]></Unit>
									<Default>
										<Value>0.0</Value>
									</Default>
									<PTCID>#x0503012b</PTCID>
								</Parameter>
								<Parameter Group="Control Parameter">
									<Name>Integral Gain (Ki)</Name>
									<Comment><![CDATA[The integral gain is multiplied with the integral of the error, resulting in one term of the control value.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Unit><![CDATA[[ControlValueUnit]/([PosUnit]*s)]]></Unit>
									<Default>
										<Value>0.0</Value>
									</Default>
									<PTCID>#x0503012c</PTCID>
								</Parameter>
								<Parameter Group="Control Parameter">
									<Name>Integrator Threshold Minimum Velocity</Name>
									<Comment><![CDATA[Integrator does not change if the actual velocity is less than Minimum Velocity. Minimum must be less than or equal to 0.0 and Maximum must be greater than 0.0.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Unit><![CDATA[[PosUnit]/s]]></Unit>
									<Default>
										<Constant><![CDATA[#Ignore]]></Constant>
									</Default>
									<PTCID>#x050301bb</PTCID>
								</Parameter>
								<Parameter Group="Control Parameter">
									<Name>Integrator Threshold Maximum Velocity</Name>
									<Comment><![CDATA[Integrator does not change if the actual velocity is larger than Maximum Velocity. Minimum must be less than or equal to 0.0 and Maximum must be greater than 0.0.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Unit><![CDATA[[PosUnit]/s]]></Unit>
									<Default>
										<Constant><![CDATA[#Ignore]]></Constant>
									</Default>
									<PTCID>#x050301bc</PTCID>
								</Parameter>
								<Parameter Group="Control Parameter">
									<Name>Integrator Lag Window Minimum</Name>
									<Comment><![CDATA[Integrator does not change if the actual lag is outside of this interval. Minimum Lag must be greater than 0.0]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Unit><![CDATA[[PosUnit]]]></Unit>
									<Default>
										<Constant><![CDATA[#Ignore]]></Constant>
									</Default>
									<PTCID>#x050301b9</PTCID>
								</Parameter>
								<Parameter Group="Control Parameter">
									<Name>Integrator Lag Window Maximum</Name>
									<Comment><![CDATA[Integrator does not change if the actual lag is outside of this interval. Maximum Lag must be greater than Minimum Lag]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Unit><![CDATA[[PosUnit]]]></Unit>
									<Default>
										<Constant><![CDATA[#Ignore]]></Constant>
									</Default>
									<PTCID>#x050301ba</PTCID>
								</Parameter>
								<Parameter Group="Output Limitation">
									<Name>Integrator Minimum Output</Name>
									<Comment><![CDATA[Minimum output of the integrator. Must have value less or equal Integrator Maximum Output.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Unit><![CDATA[[ControlValueUnit]]]></Unit>
									<Default>
										<Constant><![CDATA[#Ignore]]></Constant>
									</Default>
									<PTCID>#x050301b7</PTCID>
								</Parameter>
								<Parameter Group="Output Limitation">
									<Name>Integrator Maximum Output</Name>
									<Comment><![CDATA[Maximum output of the integrator. Must have value greater or equal Integrator Minimum Output.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Unit><![CDATA[[ControlValueUnit]]]></Unit>
									<Default>
										<Constant><![CDATA[#Ignore]]></Constant>
									</Default>
									<PTCID>#x050301b8</PTCID>
								</Parameter>
								<Parameter Group="Output Limitation">
									<Name>Minimum Output</Name>
									<Comment><![CDATA[Minimum output of the controller. Must have value less or equal Maximum Output.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Unit><![CDATA[[ControlValueUnit]]]></Unit>
									<Default>
										<Constant><![CDATA[#Ignore]]></Constant>
									</Default>
									<PTCID>#x050301bd</PTCID>
								</Parameter>
								<Parameter Group="Output Limitation">
									<Name>Maximum Output</Name>
									<Comment><![CDATA[Maximum output of the controller. Must have value greater or equal Minimum Output.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Unit><![CDATA[[ControlValueUnit]]]></Unit>
									<Default>
										<Constant><![CDATA[#Ignore]]></Constant>
									</Default>
									<PTCID>#x050301be</PTCID>
								</Parameter>
								<Parameter OnlineParameter="true" CreateSymbol="true" ReadOnly="true">
									<Name>Control Value Final Output</Name>
									<Comment><![CDATA[Sum of P-part, I-part, D-part and FF-part.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Unit><![CDATA[[ControlValueUnit]]]></Unit>
