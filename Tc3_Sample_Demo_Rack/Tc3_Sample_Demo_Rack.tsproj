					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
				<Parameter Group="Manual Motion">
					<Name>Jog Velocity Fast</Name>
					<Comment><![CDATA[This target velocity is used for jog commands with high velocity e.g. for jog commands '> >' and '< <' on the Motion UI.]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
