						<Module Id="#x010101c0" KeepUnrestoredLinks="2" HideInstance="true" ClassFactoryId="Beckhoff Automation GmbH|Tc3_Mc3Ptp_Core|4.0.12.0">
							<Name>Actual Position Filter</Name>
							<ImageId>1003</ImageId>
							<TmcDesc GUID="{7C66DF84-604A-482D-B8AD-6FD6EE811FEA}" ClassFactoryId="Beckhoff Automation GmbH|Tc3_Mc3Ptp_Core|4.0.12.0">
								<Name>Actual Position Filter</Name>
								<CLSID ClassFactory="Tc3_Mc3Ptp_Core">{050300D6-0000-0000-F000-000000000064}</CLSID>
								<Info>
									<ImageData></ImageData>
								</Info>
								<InitSequence>PSO</InitSequence>
								<Contexts>
									<Context>
										<Id>1</Id>
										<Name>Default</Name>
									</Context>
								</Contexts>
								<Parameters>
									<Group Collapsed="true"><![CDATA[Settings]]></Group>
									<Parameter Group="Settings">
										<Name>Filter Type</Name>
										<Comment><![CDATA[
				Defines the filter algorithm. The following types are available:
				PT1: A first order low-pass;
				MovingAverage: Outputs the average over the filter time of the input signal.]]></Comment>
										<BitSize>32</BitSize>
										<BaseType GUID="{3F34B9FE-8221-4E5F-824C-95044829EF5D}" Namespace="MC">EFilterType</BaseType>
										<Default>
											<EnumText>None</EnumText>
										</Default>
										<PTCID>#x05030127</PTCID>
									</Parameter>
									<Parameter Group="Settings">
										<Name>Filter Time Position</Name>
										<Comment><![CDATA[Increasing positive values increase smoothing and delay of the actual position, zero means no filtering.]]></Comment>
										<BitSize>64</BitSize>
										<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
										<Unit><![CDATA[s]]></Unit>
										<Default>
											<Value>0.0</Value>
										</Default>
										<PTCID>#x05030110</PTCID>
										<DependOn>
											<PTCID>#x05030127</PTCID>
											<Equals>
												<EnumText>PT1</EnumText>
											</Equals>
											<Equals>
												<EnumText>MovingAverage</EnumText>
											</Equals>
										</DependOn>
									</Parameter>
									<Parameter Group="Settings">
										<Name>Filter Time Velocity</Name>
										<Comment><![CDATA[Increasing positive values increase smoothing and delay of the actual velocity, zero means no filtering.]]></Comment>
										<BitSize>64</BitSize>
										<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
										<Unit><![CDATA[s]]></Unit>
										<Default>
											<Value>0.0</Value>
										</Default>
										<PTCID>#x05030111</PTCID>
										<DependOn>
											<PTCID>#x05030127</PTCID>
											<Equals>
												<EnumText>PT1</EnumText>
											</Equals>
											<Equals>
												<EnumText>MovingAverage</EnumText>
											</Equals>
										</DependOn>
									</Parameter>
									<Parameter Group="Settings">
										<Name>Filter Time Acceleration</Name>
										<Comment><![CDATA[Increasing positive values increase smoothing and delay of the actual acceleration, zero means no filtering.]]></Comment>
										<BitSize>64</BitSize>
										<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
										<Unit><![CDATA[s]]></Unit>
										<Default>
											<Value>0.01</Value>
										</Default>
										<PTCID>#x05030112</PTCID>
										<DependOn>
											<PTCID>#x05030127</PTCID>
											<Equals>
												<EnumText>PT1</EnumText>
											</Equals>
											<Equals>
												<EnumText>MovingAverage</EnumText>
											</Equals>
										</DependOn>
									</Parameter>
									<Parameter Group="Settings">
										<Name>Filter Time</Name>
										<Comment><![CDATA[Filter time for the Kalman filter. The value is squared internally to obtain the observation noise covariance (R_sigma_s). Larger values produce smoother output, smaller values follow the measured position more closely.]]></Comment>
										<BitSize>64</BitSize>
										<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
										<Unit><![CDATA[s]]></Unit>
										<Default>
											<Value>0.001</Value>
										</Default>
										<PTCID>#x05030350</PTCID>
										<DependOn>
											<PTCID>#x05030127</PTCID>
											<Equals>
												<EnumText>KalmanFilter3x1</EnumText>
											</Equals>
											<Equals>
												<EnumText>KalmanFilter4x1</EnumText>
											</Equals>
										</DependOn>
									</Parameter>
								</Parameters>
								<Properties>
									<Property>
										<Name>Category</Name>
										<Value>PositionFilterChild</Value>
									</Property>
									<Property>
										<Name>Category</Name>
										<Value>HideTcComContextPP</Value>
									</Property>
									<Property>
										<Name>ChildCategory</Name>
										<Value>ActualPositionFilterChild</Value>
									</Property>
								</Properties>
								<ParentOTCID>#x01010190</ParentOTCID>
								<ParameterValues>
									<Value>
										<Name>Filter Type</Name>
										<EnumText>None</EnumText>
									</Value>
									<Value>
										<Name>Filter Time Position</Name>
										<Value>0</Value>
									</Value>
									<Value>
										<Name>Filter Time Velocity</Name>
										<Value>0</Value>
									</Value>
									<Value>
										<Name>Filter Time Acceleration</Name>
										<Value>0.01</Value>
									</Value>
									<Value>
										<Name>Filter Time</Name>
										<Value>0.001</Value>
									</Value>
								</ParameterValues>
							</TmcDesc>
						</Module>
					</Module>
				</Axis>
			</MC>
		</Motion>
