										<OTCID>#x020100a0</OTCID>
									</ManualConfig>
									<Priority>14</Priority>
									<CycleTime>2000000</CycleTime>
									<DependOn>ParentObject</DependOn>
								</Context>
								<Context>
									<Id>1</Id>
									<ManualConfig>
										<OTCID>#x020100b0</OTCID>
									</ManualConfig>
									<Priority>15</Priority>
									<CycleTime>10000000</CycleTime>
									<DependOn>ParentObject</DependOn>
								</Context>
							</Contexts>
							<Parameters>
								<Parameter>
									<Name>Valve Linearization Enabled</Name>
									<Comment><![CDATA[Enables linearization of the drive output to compensate non-linear valve behavior.]]></Comment>
									<BitSize>8</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-000000000030}">BOOL</BaseType>
									<Default>
										<Bool>true</Bool>
									</Default>
									<PTCID>#x0503d012</PTCID>
									<ContextId OnlineAccess="true">0</ContextId>
								</Parameter>
								<Parameter HideParameter="true">
									<Name>Positive Interpolation Limit</Name>
									<Comment><![CDATA[For positive velocities less than "Positive Interpolation Limit" the spool position is linearly interpolated between the data points (0;0) and ("Positive Interpolation Limit"; Velocity at "Positive Interpolation Limit"). Can be set to '#Ignore' if no interpolation is desired, otherwise must have a value 0.0 <= value <= 1.0. The data points are calculated automatically from stored data points if no such points exist in the stored data points.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Default>
										<Constant><![CDATA[#Ignore]]></Constant>
									</Default>
									<PTCID>#x050301b5</PTCID>
									<ContextId OnlineAccess="true">0</ContextId>
								</Parameter>
								<Parameter HideParameter="true">
									<Name>Negative Interpolation Limit</Name>
									<Comment><![CDATA[For negative velocities greater than -"Negative Interpolation Limit" the spool position is linearly interpolated between the data points (-"Negative Interpolation Limit"; Velocity at -"Negative Interpolation Limit") and (0;0). Can be set to '#Ignore' if no interpolation is desired, otherwise must have a value 0.0 <= value <= 1.0. The data points are calculated automatically from stored data points if no such points exist in the stored data points.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Default>
										<Constant><![CDATA[#Ignore]]></Constant>
									</Default>
									<PTCID>#x050301b6</PTCID>
									<ContextId OnlineAccess="true">0</ContextId>
								</Parameter>
							</Parameters>
							<DataAreas>
								<DataArea>
									<AreaNo AreaType="OutputSrc">1</AreaNo>
									<Name>McToPlc</Name>
									<ContextId>0</ContextId>
									<ByteSize>4</ByteSize>
									<Symbol>
