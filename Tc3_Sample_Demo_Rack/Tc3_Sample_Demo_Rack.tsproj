							</Contexts>
							<Parameters>
								<Parameter>
									<Name>Cylinder Design</Name>
									<Comment><![CDATA[Selects the hydraulic cylinder type. Determines how bore and rod diameters are used for force and area calculations.]]></Comment>
									<BitSize>16</BitSize>
									<BaseType GUID="{568767C0-32B1-4755-BF22-9A1919AE4731}" Namespace="MC">ECylinderDesign</BaseType>
									<Default>
										<EnumText>Differential</EnumText>
									</Default>
									<PTCID>#x050301a4</PTCID>
									<ContextId OnlineAccess="true">0</ContextId>
								</Parameter>
								<Parameter>
									<Name>Cylinder Bore Diameter</Name>
									<Comment><![CDATA[Inner diameter of the hydraulic cylinder bore. Used for piston area and force calculation.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Unit><![CDATA[mm]]></Unit>
									<Default>
										<Constant><![CDATA[#Ignore]]></Constant>
									</Default>
									<PTCID>#x050301a5</PTCID>
									<ContextId OnlineAccess="true">0</ContextId>
								</Parameter>
								<Parameter>
									<Name>Cylinder Rod Diameter</Name>
									<Comment><![CDATA[Diameter of the cylinder rod. Relevant for Differential and Synchronous cylinder designs to calculate the effective rod-side piston area.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Unit><![CDATA[mm]]></Unit>
									<Default>
										<Constant><![CDATA[#Ignore]]></Constant>
									</Default>
									<PTCID>#x050301a6</PTCID>
									<ContextId OnlineAccess="true">0</ContextId>
									<DependOn>
										<PTCID>#x050301a4</PTCID>
										<Equals>
											<EnumText>Differential</EnumText>
										</Equals>
										<Equals>
											<EnumText>Synchronous</EnumText>
										</Equals>
									</DependOn>
								</Parameter>
							</Parameters>
							<Properties>
								<Property>
									<Name>Category</Name>
									<Value>AxisChild</Value>
								</Property>
