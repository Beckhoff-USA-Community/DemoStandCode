								<Parameter Group="Scaling">
									<Name>Velocity Scaling Numerator To Hardware</Name>
									<Comment><![CDATA[Applied to calculate analog output value from velocity setpoint.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Unit><![CDATA[INC/([PosUnit]/s)]]></Unit>
