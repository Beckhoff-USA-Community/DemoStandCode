									<Unit><![CDATA[[ControlValueUnit]]]></Unit>
									<PTCID>#x0503014a</PTCID>
								</Parameter>
								<Parameter OnlineParameter="true" CreateSymbol="true" ReadOnly="true">
									<Name>Control Value Derivative Part</Name>
