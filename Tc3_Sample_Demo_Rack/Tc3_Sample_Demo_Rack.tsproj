		<DataType>
			<Name GUID="{2719D350-A47B-4785-A4FF-7C5A014A4ACB}" Namespace="MC" TcBaseType="true">EMcTaskInternalSequence</Name>
			<BitSize>32</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[FastReaction]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Execution order: Commands - Exec - Output. Processes new commands before output update, providing the fastest reaction to new commands.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Stable]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[Execution order: Output - Commands - Exec. Output update is executed first, then new commands are processed, providing less jitter for output update.]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>plcAttribute_qualified_only</Name>
				</Property>
				<Property>
					<Name>plcAttribute_strict</Name>
				</Property>
				<Property>
					<Name>plcAttribute_to_string</Name>
				</Property>
			</Properties>
			<Hides>
				<Hide GUID="{B4BE03D8-1304-440C-AA14-D00591C7909E}"/>
			</Hides>
		</DataType>
