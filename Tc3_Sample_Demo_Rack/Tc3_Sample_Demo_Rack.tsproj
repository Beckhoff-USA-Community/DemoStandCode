									<ContextId OnlineAccess="true">0</ContextId>
								</Parameter>
								<Parameter Group="Scaling">
									<Name>Output Zero Offset</Name>
									<Comment><![CDATA[Output at zero velocity in relation (percent) to maximum output range (+-32767 for analog drive).]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
