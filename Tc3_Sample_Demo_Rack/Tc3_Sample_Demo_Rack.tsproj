						<Module Id="#x01010180" KeepUnrestoredLinks="2" HideInstance="true" ClassFactoryId="Beckhoff Automation GmbH|Tc3_Mc3Ptp_Core|4.0.12.0">
							<Name>Filter Pressure Sensor B</Name>
							<ImageId>1003</ImageId>
							<TmcDesc GUID="{EA1EC4AE-7852-4884-95D8-3E74F49F594E}" ClassFactoryId="Beckhoff Automation GmbH|Tc3_Mc3Ptp_Core|4.0.12.0">
								<Name>Actual Load Filter</Name>
								<CLSID ClassFactory="Tc3_Mc3Ptp_Core">{050300DA-0000-0000-F000-000000000064}</CLSID>
								<Info>
									<ImageData></ImageData>
								</Info>
								<InitSequence>PSO</InitSequence>
								<Contexts>
									<Context>
										<Id>1</Id>
										<Name>Default</Name>
									</Context>
								</Contexts>
								<Parameters>
									<Group Collapsed="true"><![CDATA[Settings]]></Group>
									<Parameter Group="Settings">
										<Name>Filter Type</Name>
										<Comment><![CDATA[
				Defines the filter algorithm. The following types are available:
				PT1: A first order low-pass;
				MovingAverage: Outputs the average over the filter time of the input signal.
			]]></Comment>
										<BitSize>32</BitSize>
										<BaseType GUID="{3F34B9FE-8221-4E5F-824C-95044829EF5D}" Namespace="MC">EFilterType</BaseType>
										<Default>
											<EnumText>None</EnumText>
										</Default>
										<PTCID>#x05030127</PTCID>
									</Parameter>
									<Parameter Group="Settings">
										<Name>Filter Time Load</Name>
										<Comment><![CDATA[Increasing positive values increase smoothing and delay of the actual load, zero means no filtering.]]></Comment>
										<BitSize>64</BitSize>
										<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
										<Unit><![CDATA[s]]></Unit>
										<Default>
											<Value>0.0</Value>
										</Default>
										<PTCID>#x05030110</PTCID>
										<DependOn>
											<PTCID>#x05030127</PTCID>
											<Equals>
												<EnumText>PT1</EnumText>
											</Equals>
											<Equals>
												<EnumText>MovingAverage</EnumText>
											</Equals>
										</DependOn>
									</Parameter>
									<Parameter Group="Settings">
										<Name>Filter Time Load Derivative</Name>
										<Comment><![CDATA[Increasing positive values increase smoothing and delay of the actual load derivative, zero means no filtering.]]></Comment>
										<BitSize>64</BitSize>
										<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
										<Unit><![CDATA[s]]></Unit>
										<Default>
											<Value>0.005</Value>
										</Default>
										<PTCID>#x05030111</PTCID>
										<DependOn>
											<PTCID>#x05030127</PTCID>
											<Equals>
												<EnumText>PT1</EnumText>
											</Equals>
											<Equals>
												<EnumText>MovingAverage</EnumText>
											</Equals>
										</DependOn>
									</Parameter>
									<Parameter Group="Settings">
										<Name>Filter Time Load Second Derivative</Name>
										<Comment><![CDATA[Increasing positive values increase smoothing and delay of the actual load second derivative, zero means no filtering.]]></Comment>
										<BitSize>64</BitSize>
										<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
										<Unit><![CDATA[s]]></Unit>
										<Default>
											<Value>0.01</Value>
										</Default>
										<PTCID>#x05030112</PTCID>
										<DependOn>
											<PTCID>#x05030127</PTCID>
											<Equals>
												<EnumText>PT1</EnumText>
											</Equals>
											<Equals>
												<EnumText>MovingAverage</EnumText>
											</Equals>
										</DependOn>
									</Parameter>
									<Parameter Group="Settings">
										<Name>Filter Time</Name>
										<Comment><![CDATA[Filter time for the Kalman filter. The value is squared internally to obtain the observation noise covariance (R_sigma_s). Larger values produce smoother output, smaller values follow the measured signal more closely.]]></Comment>
										<BitSize>64</BitSize>
										<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
										<Unit><![CDATA[s]]></Unit>
										<Default>
											<Value>0.001</Value>
										</Default>
										<PTCID>#x05030350</PTCID>
										<DependOn>
											<PTCID>#x05030127</PTCID>
											<Equals>
												<EnumText>KalmanFilter3x1</EnumText>
											</Equals>
											<Equals>
												<EnumText>KalmanFilter4x1</EnumText>
											</Equals>
										</DependOn>
									</Parameter>
								</Parameters>
								<Properties>
									<Property>
										<Name>Category</Name>
										<Value>LoadFilterChild</Value>
									</Property>
									<Property>
										<Name>Category</Name>
										<Value>HideTcComContextPP</Value>
									</Property>
									<Property>
										<Name>ChildCategory</Name>
										<Value>ActualLoadFilterChild</Value>
									</Property>
								</Properties>
								<ParentOTCID>#x01010170</ParentOTCID>
								<ParameterValues>
									<Value>
										<Name>Filter Type</Name>
										<EnumText>None</EnumText>
									</Value>
									<Value>
										<Name>Filter Time Load</Name>
										<Value>0</Value>
									</Value>
									<Value>
										<Name>Filter Time Load Derivative</Name>
										<Value>0.005</Value>
									</Value>
									<Value>
										<Name>Filter Time Load Second Derivative</Name>
										<Value>0.01</Value>
									</Value>
									<Value>
										<Name>Filter Time</Name>
										<Value>0.001</Value>
									</Value>
								</ParameterValues>
							</TmcDesc>
						</Module>
					</Module>
					<Module Id="#x010101a0" KeepUnrestoredLinks="2" HideInstance="true" ClassFactoryId="Beckhoff Automation GmbH|Tc3_Mc3FluidPower_Core|4.0.12.0">
