									<ContextId OnlineAccess="true">0</ContextId>
								</Parameter>
								<Parameter>
									<Name>Cylinder Rod Diameter</Name>
									<Comment><![CDATA[Diameter of the cylinder rod. Relevant for Differential and Synchronous cylinder designs to calculate the effective rod-side piston area.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
