		<DataType>
			<Name GUID="{EC228BB1-A74E-4EA9-958E-255C8F4CB262}" Namespace="MC" TcBaseType="true">EDeadTimeCompensationMode</Name>
			<BitSize>32</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[None]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[No dead time compensation applied.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[LastVelocity]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[Compensation uses the last known velocity to extrapolate the actual position.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[LastVelocityAcceleration]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[Compensation uses the last known velocity and acceleration for more accurate extrapolation.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[NonlinearShift]]></Text>
				<Enum>10</Enum>
				<Comment><![CDATA[Compensation applies a non-linear time shift method for improved accuracy in dynamic motion. The history of the last actual values is taken into account.]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>plcAttribute_qualified_only</Name>
				</Property>
				<Property>
					<Name>plcAttribute_strict</Name>
				</Property>
				<Property>
					<Name>plcAttribute_to_string</Name>
				</Property>
			</Properties>
			<Hides>
				<Hide GUID="{3579DC84-5E53-4E5C-8A8D-F9DC4B3E2922}"/>
			</Hides>
		</DataType>
