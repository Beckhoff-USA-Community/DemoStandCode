									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
									<Unit><![CDATA[[ControlValueUnit]]]></Unit>
									<PTCID>#x05030130</PTCID>
								</Parameter>
								<Parameter OnlineParameter="true" CreateSymbol="true" ReadOnly="true">
