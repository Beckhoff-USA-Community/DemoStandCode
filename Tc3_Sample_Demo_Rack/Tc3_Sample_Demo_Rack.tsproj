			<BitSize>32</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[AbsoluteFullRange]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Absolute encoder using the full data range defined by the data type of mapping element (default).]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[AbsoluteUserDataRange]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[Absolute encoder with user-defined absolute data range and overflow position.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Incremental]]></Text>
				<Enum>4</Enum>
				<Comment><![CDATA[Incremental encoder providing relative position changes only. For example, if position recovery after a power cycle is not possible. A homing sequence is necessary.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[AbsoluteModulo]]></Text>
				<Enum>5</Enum>
				<Comment><![CDATA[Absolute encoder interpreted as modulo position within the configured range if the modulo operating mode is set on drive/encoder device.]]></Comment>
			</EnumInfo>
