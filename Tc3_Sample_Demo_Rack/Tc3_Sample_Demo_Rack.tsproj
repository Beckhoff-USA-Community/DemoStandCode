			<BaseType GUID="{18071995-0000-0000-0000-000000000005}">UINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[Differential]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Differential cylinder with different piston areas on extend and retract sides.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Synchronous]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[Synchronous cylinder with equal piston areas on both sides.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Plunger]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[Plunger cylinder with a single-acting piston (no rod-side area).]]></Comment>
			</EnumInfo>
