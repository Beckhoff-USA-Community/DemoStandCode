								</Parameter>
								<Parameter OnlineParameter="true" CreateSymbol="true" ReadOnly="true">
									<Name>Control Value Proportional Part</Name>
									<Comment><![CDATA[The proportional part of the control value.]]></Comment>
									<BitSize>64</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
