					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
				<Parameter OnlineParameter="true" ReadOnly="true" Group="Scaling">
					<Name>Active Homing Offset</Name>
					<Comment><![CDATA[Displays the temporary offset calculated during the last homing sequence. This value is not stored persistently.]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
					<Unit><![CDATA[[PosUnit]]]></Unit>
