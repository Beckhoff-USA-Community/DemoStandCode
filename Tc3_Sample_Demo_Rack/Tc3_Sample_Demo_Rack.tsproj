		<ModuleTmc GUID="{1437754E-F772-4FD4-AD2D-3E16CDF29D72}" TcSmClass="TComMcAxisObj">
			<Name>Axis</Name>
			<CLSID ClassFactory="Tc3_Mc3Ptp_Core">{050300B8-0000-0000-F000-000000000064}</CLSID>
			<Info>
				<TabExtension Url="motion\ptp\views\axisui.html">
					<Url>Motion UI</Url><![CDATA[Motion UI]]></TabExtension>
			</Info>
			<Parameters>
				<Group><![CDATA[General]]></Group>
				<Group><![CDATA[Maximum Dynamics]]></Group>
				<Group><![CDATA[Default Dynamics]]></Group>
				<Group Collapsed="true"><![CDATA[Manual Motion]]></Group>
				<Group Collapsed="true"><![CDATA[Monitoring]]></Group>
				<Group Collapsed="true"><![CDATA[Error Event Handling]]></Group>
				<Group Collapsed="true"><![CDATA[Diagnostics]]></Group>
				<Group Collapsed="true"><![CDATA[Additional Error Event Information]]></Group>
				<Group Collapsed="true"><![CDATA[Additional Encoder]]></Group>
				<Group Collapsed="true"><![CDATA[Override]]></Group>
				<Group Collapsed="true"><![CDATA[Internal]]></Group>
				<Parameter Group="General">
					<Name>Simulation Mode</Name>
					<Comment><![CDATA[Whether I/O connection to drive and encoder should be active (FALSE) or simulated (TRUE). Parameter can also be written during runtime if axis state is 'Disabled'.]]></Comment>
					<BitSize>8</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-000000000030}">BOOL</BaseType>
					<Default>
						<Bool>false</Bool>
					</Default>
					<PTCID>#x050300b1</PTCID>
				</Parameter>
				<Parameter Group="General">
					<Name>Position Unit</Name>
					<Comment><![CDATA[The Position Unit is used for display purposes e.g. on the Motion UI. Inputs/outputs to/from e.g. FBs are not converted. ]]></Comment>
					<BitSize>32</BitSize>
					<BaseType GUID="{F20289EE-8CFB-4862-83EA-993DF40C82DE}" Namespace="MC">EPositionUnit</BaseType>
					<Unit><![CDATA[[PosUnit]]]></Unit>
					<Default>
						<Value>1</Value>
					</Default>
					<PTCID>#x050301a0</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
				<Parameter Group="General">
					<Name>Is Modulo Axis</Name>
					<Comment><![CDATA[Activate this parameter to use modulo functionalities on FBs. Setpoint and actpoint are calculated as absolute and modulo value in cyclic interface.]]></Comment>
					<BitSize>8</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-000000000030}">BOOL</BaseType>
					<Default>
						<Value>0</Value>
					</Default>
					<PTCID>#x05030101</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
				<Parameter Group="General">
					<Name>Position Modulus</Name>
					<Comment><![CDATA[Modulo period to calculate the modulo position]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
					<Unit><![CDATA[[PosUnit]]]></Unit>
					<Default>
						<Value>360.0</Value>
					</Default>
					<PTCID>#x05030107</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
					<DependOn>
						<PTCID>#x05030101</PTCID>
						<Equals>
							<Bool>true</Bool>
						</Equals>
					</DependOn>
				</Parameter>
				<Parameter Group="General">
					<Name>Position Modulo Tolerance Window</Name>
					<Comment><![CDATA[A movement against the specified direction is allowed if the target position is within this position tolerance of the start position. The final behavior depends on 'PositionInterpretation' input of FBs.]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
					<Unit><![CDATA[[PosUnit]]]></Unit>
					<Default>
						<Value>0.0</Value>
					</Default>
					<PTCID>#x05030108</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
					<DependOn>
						<PTCID>#x05030101</PTCID>
						<Equals>
							<Bool>true</Bool>
						</Equals>
					</DependOn>
				</Parameter>
				<Parameter Group="General">
					<Name>Axis License Mode</Name>
					<BitSize>32</BitSize>
					<BaseType GUID="{275BA82D-1BAC-4C3A-8408-35D279770DBC}" Namespace="MC">EAxisLicenseSetting</BaseType>
					<Default>
						<EnumText>Beckhoff (auto)</EnumText>
					</Default>
					<PTCID>#x050381f2</PTCID>
				</Parameter>
				<Parameter Group="Maximum Dynamics">
					<Name>Maximum Velocity</Name>
					<Comment><![CDATA[Maximum limit for velocity that is considered by profile generation. Inputs of FBs might be reduced to this limit automatically. Named constant '#Maximum' will be replaced by this value as FB input for the velocity value.]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
					<Unit><![CDATA[[PosUnit]/s]]></Unit>
					<Default>
						<Value>2000</Value>
					</Default>
					<PTCID>#x05093009</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
				<Parameter Group="Maximum Dynamics">
					<Name>Maximum Acceleration</Name>
					<Comment><![CDATA[Maximum limit for acceleration that is considered by profile generation. Inputs of FBs might be reduced to this limit automatically. Named constant '#Maximum' will be replaced by this value as FB input for the acceleration value.]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
					<Unit><![CDATA[[PosUnit]/s^2]]></Unit>
					<Default>
						<Value>10000</Value>
					</Default>
					<PTCID>#x0509300a</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
				<Parameter Group="Maximum Dynamics">
					<Name>Maximum Deceleration</Name>
					<Comment><![CDATA[Maximum limit for deceleration that is considered by profile generation. Inputs of FBs might be reduced to this limit automatically. Named constant '#Maximum' will be replaced by this value as FB input for the deceleration value.]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
					<Unit><![CDATA[[PosUnit]/s^2]]></Unit>
					<Default>
						<Value>10000</Value>
					</Default>
					<PTCID>#x0509300b</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
				<Parameter Group="Maximum Dynamics">
					<Name>Maximum Jerk</Name>
					<Comment><![CDATA[Maximum limit for jerk that is considered by profile generation. Inputs of FBs might be reduced to this limit automatically. Named constant '#Maximum' will be replaced by this value as FB input for the jerk value.]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
					<Unit><![CDATA[[PosUnit]/s^3]]></Unit>
					<Default>
						<Value>100000</Value>
					</Default>
					<PTCID>#x05093015</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
				<Parameter Group="Default Dynamics">
					<Name>Default Acceleration</Name>
					<Comment><![CDATA[This value is used for input 'Acceleration' of FBs as acceleration limit if the value is not set explicitly. Named constant '#Default' will be replaced by this value as FB input for the acceleration value.]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
					<Unit><![CDATA[[PosUnit]/s^2]]></Unit>
					<Default>
						<Value>2000</Value>
					</Default>
					<PTCID>#x0509300c</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
				<Parameter Group="Default Dynamics">
					<Name>Default Deceleration</Name>
					<Comment><![CDATA[This value is used for input 'Deceleration' of FBs as deceleration limit if the value is not set explicitly. Named constant '#Default' will be replaced by this value as FB input for the deceleration value.]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
					<Unit><![CDATA[[PosUnit]/s^2]]></Unit>
					<Default>
						<Value>2000</Value>
					</Default>
					<PTCID>#x0509300d</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
				<Parameter Group="Default Dynamics">
					<Name>Default Jerk</Name>
					<Comment><![CDATA[This value is used for input 'Jerk' of FBs as jerk limit if the value is not set explicitly. Named constant '#Default' will be replaced by this value as FB input for the jerk value.]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
					<Unit><![CDATA[[PosUnit]/s^3]]></Unit>
					<Default>
						<Value>4000</Value>
					</Default>
					<PTCID>#x0509300e</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
				<Parameter Group="Manual Motion">
